# Environment variables required for local development and production
# DO NOT commit real secrets. Use your environment or Vercel project settings.

# Better Auth (replace with a secure random string)
BETTER_AUTH_SECRET=replace_with_secure_random
BETTER_AUTH_URL=https://www.emiratesaiweather.com

# Next.js optional environment
NEXT_PUBLIC_API_BASE_URL=https://www.emiratesaiweather.com

# Example placeholders for third-party keys
# GOOGLE_API_KEY=your_google_api_key
# SENTRY_DSN=your_sentry_dsn
